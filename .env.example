# Copy to .env for local development. On Vercel, set these in
# Project Settings -> Environment Variables (or `vercel env add`).

APP_ENV=development

# Local dev defaults to a SQLite file if unset.
# Production: the pooled Neon connection string from the Vercel integration.
# DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/commoter?sslmode=require

# Signs the session cookie. REQUIRED in production — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Server-side Firebase ID token verification.
FIREBASE_PROJECT_ID=commoter

# Public Firebase web config (safe to expose — it is not a secret).
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=commoter.firebaseapp.com
FIREBASE_WEB_PROJECT_ID=commoter
FIREBASE_WEB_STORAGE_BUCKET=commoter.appspot.com
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=

# Comma-separated emails granted admin on their next sign-in.
ADMIN_EMAILS=
